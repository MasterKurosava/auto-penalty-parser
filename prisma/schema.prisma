generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.Text
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ecpAuths EcpAuth[]

  @@map("users")
  @@index([username])
}

model EcpAuth {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  label  String? @db.Text
  iinBin String  @map("iin_bin") @db.Text

  authTokenEnc    Bytes  @map("auth_token_enc")
  refreshTokenEnc Bytes? @map("refresh_token_enc")
  uuidEnc         Bytes  @map("uuid_enc")
  psapId          String @map("psap_id") @db.Text

  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  validUntil    DateTime? @map("valid_until") @db.Timestamptz(6)
  isValid       Boolean   @default(true) @map("is_valid")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fines Fine[]

  @@unique([userId, iinBin])
  @@map("ecp_authentications")
  @@index([userId])
  @@index([iinBin])
  @@index([isValid, isActive])
}

model Fine {
  id              String    @id @default(uuid()) @db.Uuid
  ecpAuthId       String    @map("ecp_auth_id") @db.Uuid
  externalId      String    @map("external_id") @db.Text

  status          String    @db.Text
  commitDate      DateTime? @map("commit_date") @db.Timestamptz(6)
  decisionDate    DateTime? @map("decision_date") @db.Timestamptz(6)
  caseNumber      String?   @map("case_number") @db.Text
  fullName        String    @map("full_name") @db.Text
  vehicleNumber   String    @map("vehicle_number") @db.Text
  serialNumber    String?   @map("serial_number") @db.Text
  articleCode     String    @map("article_code") @db.Text
  articleName     String    @map("article_name") @db.Text
  amountTotal     Decimal   @map("amount_total") @db.Decimal(14, 2)
  pdfUrl          String?   @map("pdf_url") @db.Text

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  ecpAuth EcpAuth @relation(fields: [ecpAuthId], references: [id], onDelete: Cascade)

  @@unique([ecpAuthId, externalId])
  @@map("fines")
  @@index([ecpAuthId])
  @@index([externalId])
  @@index([status])
  @@index([vehicleNumber])
  @@index([fullName])
  @@index([commitDate])
  @@index([decisionDate])
  @@index([articleCode])
  @@index([caseNumber])
  @@index([serialNumber])
  @@index([amountTotal])
  @@index([ecpAuthId, status])
  @@index([ecpAuthId, commitDate])
}
